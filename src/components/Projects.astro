---
import { projects } from '../lib/data';
import ResourceLink from './ResourceLink.astro';
---
<section class="content" id="projects"><div class="wrap"><div class="section-heading"><div><div class="eyebrow">01 / Projects</div><h2>Ideas put into practice.</h2></div><p>Academic and personal projects. A look at what I’ve built and the tools I’ve used.</p></div><div class="bento">{projects.map(project=><article class:list={['card',{main:project.featured}]}><div><span class="num">{project.label}</span><h3>{project.title}</h3><p>{project.description}</p>{project.technologies.length>0&&<div class="chips">{project.technologies.map(t=><span class="chip">{t}</span>)}</div>}{project.highlights.length>0&&<dl class="project-highlights">{project.highlights.map((feature,index)=><div class="project-feature"><dt><span class="feature-marker" aria-hidden="true">{String(index+1).padStart(2,'0')}</span>{feature.title}</dt><dd>{feature.description}</dd></div>)}</dl>}{project.workflow.length>0&&<div class="project-flow"><span class="project-flow-label">Request workflow</span><ol aria-label="Procurement request workflow">{project.workflow.map((step,index)=><li><span class="flow-step">{index+1}</span>{step}</li>)}</ol></div>}</div>{project.repository&&<ResourceLink href={project.repository} label="Explore repository" context={project.title} kind="repository" />}</article>)}</div></div></section>
