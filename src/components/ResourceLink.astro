---
interface Props { href: string; label: string; context: string; kind?: 'credential' | 'document' | 'repository'; secondary?: boolean; }
const { href, label, context, kind = 'credential', secondary = false } = Astro.props;
---
<a href={href} class:list={['resource-link', `resource-${kind}`, { 'resource-secondary': secondary }]} target="_blank" rel="noopener noreferrer" aria-label={`${label}: ${context} (opens in a new tab)`} data-tooltip={`${label}: ${context}`}>
  <span class="resource-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      {kind === 'credential' && <><path d="M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6Z"/><path d="m8.5 12 2.5 2.5 4.5-5"/></>}
      {kind === 'document' && <><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z"/><path d="M14 3v6h6M8 13h8M8 17h5"/></>}
      {kind === 'repository' && <><path d="M9 19c-4 1-4-2-6-2m13 5v-4c0-1-.4-2-1-2 4-.5 6-2 6-5 0-1.5-.5-2.5-1.5-3.5.3-1 .3-2-.2-3-1.5 0-3 1-4 1-2-.5-4-.5-6 0-1-1-2.5-1-4-1-.5 1-.5 2-.2 3C4 8.5 3.5 9.5 3.5 11c0 3 2 4.5 6 5-.6.5-1 1-1 2v4"/></>}
    </svg>
  </span>
  <span class="resource-label">{label}</span>
  <svg class="resource-arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
</a>
