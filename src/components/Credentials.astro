---
import { credentials, profile } from '../lib/data';
import ResourceLink from './ResourceLink.astro';
---
<section class="content section-soft" id="learning"><div class="wrap"><div class="section-heading"><div><div class="eyebrow">03 / Skills &amp; Learning</div><h2>Learning is part of the work.</h2></div><p>Course credentials, competition participation, and recognition—all together, with links to the source.</p></div><div class="skill-band">{profile.skills.map(skill=><span>{skill}</span>)}</div><div class="credential-tools"><div class="credential-search"><label for="credential-search">Search credentials by title or issuer</label><input type="search" id="credential-search" placeholder="Try AI, SQL, or Anthropic" autocomplete="off" aria-controls="credential-grid" /></div><span class="credential-count" id="credential-count" role="status" aria-live="polite">{credentials.length} credentials</span></div><div class="credentials" id="credential-grid">{credentials.map(c=><article class="credential" data-search={`${c.title} ${c.issuer}`}><span class="num">{c.kind==='participation'?'PARTICIPATION':c.kind==='badge'?'RECOGNITION':'COURSE CREDENTIAL'}</span><h3>{c.title}</h3><p>{c.issuer}</p>{c.date&&<time datetime={c.date}>{c.date}</time>}<div class="credential-links">{(c.verificationUrl||c.document)&&<ResourceLink href={c.verificationUrl||c.document} label="View credential" context={c.title} kind={c.verificationUrl?'credential':'document'} />}{c.verificationUrl&&c.document&&<ResourceLink href={c.document} label="View uploaded certificate" context={c.title} kind="document" secondary />}</div></article>)}</div><p class="credential-empty" id="credential-empty" hidden>No matching credentials. Try another title or issuer.</p><div class="credential-actions"><button class="button" id="credential-toggle" type="button" aria-expanded="false" aria-controls="credential-grid" hidden>Show all {credentials.length} credentials</button></div></div></section>
