---
import Layout from '../layouts/Layout.astro';
import Projects from '../components/Projects.astro';
import Credentials from '../components/Credentials.astro';
import { profile } from '../lib/data';
import icons from '../data/social-icons.json';
import { getImage } from 'astro:assets';
import darkPortrait from '../assets/portrait-dark.png';
import lightPortrait from '../assets/portrait-light.png';
import insightArt from '../assets/insights-engineering-ai.png';
const [darkImage,lightImage,insightImage] = await Promise.all([getImage({src:darkPortrait,width:680,format:'webp'}),getImage({src:lightPortrait,width:680,format:'webp'}),getImage({src:insightArt,width:720,format:'webp'})]);
---
<Layout>
<a class="skip" href="#main">Skip to content</a>
<header><div class="wrap header"><a class="brand" href="#">{profile.name}<b>.</b></a><nav aria-label="Main" id="nav"><a data-tooltip="Explore About" href="#about"><svg aria-hidden="true" fill="none" height="18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" viewBox="0 0 24 24" width="18"><circle cx="12" cy="7" r="4"></circle><path d="M4 21v-2a8 8 0 0 1 16 0v2"></path></svg><span>About</span></a><a data-tooltip="Explore Projects" href="#projects"><svg aria-hidden="true" fill="none" height="18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" viewBox="0 0 24 24" width="18"><path d="M3 7h7l2 2h9v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"></path><path d="M3 7V5a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v2"></path></svg><span>Projects</span></a><a data-tooltip="Explore Skills &amp; Learning" href="#learning"><svg aria-hidden="true" fill="none" height="18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" viewBox="0 0 24 24" width="18"><path d="m2 9 10-6 10 6-10 6Zm4 3v6c4 3 8 3 12 0v-6m4-3v9"></path></svg><span>Skills &amp; Learning</span></a><a data-tooltip="Explore Insights" href="#insights"><svg aria-hidden="true" fill="none" height="18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" viewBox="0 0 24 24" width="18"><path d="M9 18h6m-5 3h4M8 14a7 7 0 1 1 8 0c-1 1-1 2-1 3H9c0-1 0-2-1-3Z"></path></svg><span>Insights</span></a><a data-tooltip="Explore Contact" href="#contact"><svg aria-hidden="true" fill="none" height="18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" viewBox="0 0 24 24" width="18"><rect height="14" rx="3" width="18" x="3" y="5"></rect><path d="m3 7 9 6 9-6"></path></svg><span>Contact</span></a></nav><div class="controls"><button aria-label="Switch to light theme" class="control icon-button" data-tooltip="Switch to light theme" id="theme"><svg aria-hidden="true" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" viewBox="0 0 24 24" width="20"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5"></path></svg></button><button aria-controls="nav" aria-expanded="false" aria-label="Open navigation" class="control menu" data-tooltip="Open navigation" id="menu"><svg aria-hidden="true" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" viewBox="0 0 24 24" width="20"><path d="M4 6h16M4 12h16M4 18h16"></path></svg></button></div></div><div aria-hidden="true" class="reading-progress"></div></header><div aria-hidden="true" class="ambient-world"><canvas id="world"></canvas><div class="aura aura-one"></div><div class="aura aura-two"></div><div class="world-grid"></div><div class="beam beam-one"></div><div class="beam beam-two"></div></div><main id="main"><section class="hero"><div aria-hidden="true" class="hero-film"><video id="hero-video" muted loop playsinline preload="none" poster="/videos/hero-neural-systems-poster.jpg" tabindex="-1"><source data-src="/videos/hero-neural-systems.mp4" type="video/mp4" /></video><div class="film-shade"></div></div><canvas aria-hidden="true" id="ambient"></canvas><div class="wrap hero-grid"><div class="hero-copy"><div class="eyebrow">Software development · Artificial intelligence<span aria-hidden="true" class="signal"></span></div><h1>{profile.name}</h1><p class="hero-profession">{profile.focus}</p><p class="hero-tagline">{profile.tagline}</p><div class="role"><span aria-hidden="true" id="typing">Building with purpose.</span><span aria-hidden="true" class="caret"></span><span style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)">Building with purpose. Learning through practice. Exploring artificial intelligence.</span></div><p>{profile.introduction}</p><div class="actions"><a class="button primary" href="#projects">Explore my projects <span>↗</span></a><a class="button" href="#contact">Let’s connect <span>→</span></a></div><div class="hero-foot"><span>BASED IN {profile.location.toUpperCase()}</span><span class="dot"></span><span>LEARNING. BUILDING. EVOLVING.</span></div></div><div class="portrait-stage" data-tooltip="Byamugisha Alban · Software Engineering student"><div class="portrait-halo"></div><div class="portrait-shell"><div class="scan-line"></div><div class="corner top-left"></div><div class="corner bottom-right"></div><img class="portrait" id="portrait" src={darkImage.src} data-dark={darkImage.src} data-light={lightImage.src} alt="Byamugisha Alban" width="680" height="680" fetchpriority="high" decoding="async" /></div><div class="portrait-label"><small>THE PERSON BEHIND THE CODE</small>Byamugisha Alban</div></div></div></section><Projects /><section class="content section-soft" id="about"><div class="wrap"><div class="section-heading"><div><div class="eyebrow">02 / About</div><h2>Always a student.<br/>Always building.</h2></div></div><div class="about-grid"><div><p class="about-text">{profile.about}</p><p>{profile.values}</p><a class="button" href={profile.cv} download data-tooltip="Download Byamugisha Alban’s CV">Download CV ↓</a></div><div class="timeline">{profile.education.map(e=><div><small>{e.period}</small><strong>{e.qualification}</strong><p>{e.institution}</p></div>)}</div></div></div></section><Credentials /><section class="content section-soft" id="insights"><div class="wrap"><div class="section-heading"><div><div class="eyebrow">04 / Insights</div><h2>Thinking beyond the syntax.</h2></div><p>Reflections on software, artificial intelligence, and learning to build with judgement.</p></div><article class="insight"><div class="insight-art"><img src={insightImage.src} alt="A glass hand aligning a glowing module within an architectural lattice, illustrating engineering judgement alongside AI" width="720" height="720" loading="lazy" decoding="async" /><div class="art-caption">ENGINEERING × AI</div></div><div><span class="num">3 SEPTEMBER 2026 · ENGINEERING &amp; AI</span><h3>AI Doesn't Replace Engineers. It Exposes Who Isn't One. It Still Can't Think Like an Engineer.</h3><p>“The syntax was never the hard part. The hard part is judgement: knowing what to build, what to question, and what to leave alone.”</p><a href="https://lnkd.in/p/dR_zSFM5" rel="noopener noreferrer" target="_blank">Read on LinkedIn ↗</a><p><a href="/insights/engineering-judgement-and-ai/">Read the full article here →</a></p></div></article></div></section><section class="content section-soft" id="contact"><div class="wrap contact-grid"><div><div class="eyebrow">05 / Contact</div><h2>A conversation<br/>starts here.</h2><p>Have a question, an idea, or something to share?<br/>Let’s connect.</p><a class="contact-link" data-tooltip="Email Byamugisha Alban" href={`mailto:${profile.email}`}><svg aria-hidden="true" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" viewBox="0 0 24 24" width="20"><rect height="14" rx="3" width="18" x="3" y="5"></rect><path d="m3 7 9 6 9-6"></path></svg> <span>{profile.email}</span></a><div class="socials">{profile.socials.map(s=><a class="social-icon" href={s.url} aria-label={s.label} data-tooltip={s.label} target={s.url.startsWith("https:")?"_blank":undefined} rel={s.url.startsWith("https:")?"noopener noreferrer":undefined}><Fragment set:html={icons[s.label as keyof typeof icons] || icons.GitHub}/></a>)}</div></div><form id="form" action={`https://formsubmit.co/${profile.email}`} method="POST" data-endpoint={`https://formsubmit.co/ajax/${profile.email}`}><input type="hidden" name="_subject" value="New portfolio message" /><input type="hidden" name="_template" value="table" /><input type="hidden" name="_next" value="https://albanbyamugisha.github.io/message-received/" /><div hidden aria-hidden="true"><label for="website">Leave this field empty</label><input id="website" name="_honey" tabindex="-1" autocomplete="off" /></div><label for="name">Your name</label><input autocomplete="name" id="name" maxlength="100" name="name" placeholder="Name" required=""/><label for="email">Email address</label><input autocomplete="email" id="email" maxlength="254" name="email" placeholder="you@example.com" required="" type="email"/><label for="message">Your message</label><textarea id="message" maxlength="5000" name="message" placeholder="What’s on your mind?" required=""></textarea><button class="button" data-tooltip="Send your message" id="send-message" type="submit">Send Message <svg aria-hidden="true" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" viewBox="0 0 24 24" width="20"><path d="m22 2-7 20-4-9-9-4Zm0 0L11 13"></path></svg></button><div class="form-status" id="form-note" role="status" aria-live="polite" aria-atomic="true" hidden><span class="status-icon" id="status-icon" aria-hidden="true"></span><div class="status-copy"><strong id="status-title"></strong><p id="status-message"></p><div class="status-actions" id="status-actions" hidden><button type="button" class="status-retry" id="retry-message" data-tooltip="Try sending your message again">Try again <span aria-hidden="true">↻</span></button><a id="status-email" href={`mailto:${profile.email}`} data-tooltip="Send your message using your email app">Email me instead <span aria-hidden="true">↗</span></a></div></div></div><p class="form-privacy">Your name, email, and message are used to respond to your enquiry. <a href="/privacy/">Privacy details</a>. Prefer email? <a href={`mailto:${profile.email}`}>Contact me directly</a>.</p></form></div></section></main><footer><div class="wrap footer"><strong>Byamugisha Alban.</strong><span>Uganda · Software development &amp; artificial intelligence</span><span>© {new Date().getFullYear()} · <a href="/privacy/">Privacy</a></span></div></footer><div aria-live="polite" class="activity-indicator" hidden="" id="activity-indicator" role="status"><div class="activity-avatar"><img alt="" height="32" src="/images/favicon-round.png" width="32"/><span></span></div><span id="activity-label">Loading</span></div><div aria-label="Page navigation" class="scroll-controls"><a aria-label="Go to next section" class="scroll-button" data-tooltip="Next section" href="#projects" id="next-section"><svg aria-hidden="true" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" viewBox="0 0 24 24" width="20"><path d="m6 12 6 6 6-6M12 18V4"></path></svg></a><a aria-label="Back to top" class="scroll-button" data-tooltip="Back to top" href="#main" id="back-top"><svg aria-hidden="true" fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" viewBox="0 0 24 24" width="20"><path d="m6 12 6-6 6 6M12 6v14"></path></svg></a></div><div id="tooltip" role="tooltip"></div><div aria-label="Loading portfolio" class="page-loader" id="page-loader" role="status"><div class="image-throbber"><img alt="" height="90" src="/images/favicon-round.png" width="90"/><div class="throbber-ring"></div></div><span>Preparing your view<span class="loading-dots">...</span></span></div><script>import '../scripts/site.js';</script>
</Layout>
